  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Calcium sulphide ore is a rare and unusual resource found on Mercury,
    shaped by the planet\u2019s extreme temperatures and airless environment. Formed
    through intense chemical reactions between calcium rich rocks and sulphur compounds,
    this ore is most commonly discovered in ancient impact zones and regions exposed
    to long periods of extreme heat. Mercury\u2019s lack of atmosphere allows these
    minerals to remain stable on the surface, creating pale, chalky deposits hidden
    among scorched rock. When refined, calcium sulphide is valuable for advanced
    chemical processing, high temperature materials, and specialized compounds used
    in energy systems and industrial crafting."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
