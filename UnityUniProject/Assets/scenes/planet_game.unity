  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Welcome to Jupiter the largest planet in the solar system and a true giant
    among worlds. Jupiter is a massive gas planet made mostly of hydrogen and helium,
    with no solid surface to stand on, only endless layers of thick clouds and crushing
    pressure below. Its colorful bands are created by powerful storms and jet streams,
    including the famous Great Red Spot, a storm so large it has raged for centuries
    and could swallow Earth whole. Jupiter\u2019s gravity is incredibly strong, shaping
    the orbits of nearby objects and protecting the inner planets by capturing or
    deflecting asteroids. The planet has dozens of moons, some of the most interesting
    worlds in the solar system, including icy Europa, volcanic Io, and massive Ganymede.
    With intense radiation, violent weather, and immense scale, Jupiter is a dangerous
    and awe-inspiring planet."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
