  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jarosite ore is a rare and scientifically significant mineral found on
    Mars, strongly linked to the planet\u2019s acidic and water rich past. Forming
    in environments where sulphur rich fluids interact with iron bearing rocks, jarosite
    is clear evidence that liquid water once existed on Mars under harsh, acidic
    conditions. It appears as yellowish brown or rust coloured crystalline deposits
    embedded in sedimentary rock, often located in ancient lakebeds and weathered
    surface layers. Although not a metal itself, jarosite is valuable for advanced
    chemical processing, research, and extraction of iron and sulphur compounds."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
