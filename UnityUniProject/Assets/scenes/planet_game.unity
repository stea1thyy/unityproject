  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Magnesium sulphide is a rare, heat formed resource found on Mercury, created
    by the planet\u2019s extreme temperature swings and sulphur rich surface chemistry.
    In Mercury\u2019s airless environment, magnesium rich rocks can react with sulphur
    compounds under intense heat, forming pale mineral deposits near impact craters
    and ancient volcanic regions. These ores remain stable in Mercury\u2019s harsh
    conditions, where powerful sunlight and rapid cooling prevent them from breaking
    down easily. Once refined, magnesium sulphide is highly valued for use in high
    temperature alloys, advanced chemical processes, and lightweight structural components."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
