  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Nickel is a durable and valuable metal found on Venus, shaped by the planet\u2019s
    extreme heat and violent geological history. Often mixed with iron and other
    metals, nickel deposits on Venus are believed to form deep beneath the surface
    and around ancient volcanic regions, where intense pressure and heat concentrate
    heavy elements. Unlike softer metals, nickel is highly resistant to corrosion
    and extreme temperatures, making it especially important on a planet as hostile
    as Venus. Once refined, nickel is used to strengthen alloys, improve heat resistance,
    and enhance advanced machinery and structures. Its toughness and rarity make
    nickel a high-tier resource on Venus."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
